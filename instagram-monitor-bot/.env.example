# Telegram Bot Token — von @BotFather erhalten
TELEGRAM_BOT_TOKEN=dein_bot_token_hier

# Deine Telegram Chat-ID — mit @userinfobot herausfinden
TELEGRAM_CHAT_ID=deine_chat_id_hier

# Uhrzeit des täglichen Checks (24h, Lokalzeit)
CHECK_HOUR=8
CHECK_MINUTE=0

# Optional: Instagram-Login für stabileres Scraping (empfohlen)
# Nutze am besten einen Zweit-Account!
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
